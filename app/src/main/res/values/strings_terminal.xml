<?xml version="1.0" encoding="utf-8"?>
<!--suppress LongLine -->
<resources>
    <!-- Toolbar/screen title of the built-in terminal. -->
    <string name="term_title">终端</string>

    <!-- The current privilege mode of the terminal.
         Param 1: the translated name of the privilege mode. -->
    <string name="term_mode_fmt">权限模式：%1$s</string>
    <!-- Tooltip of the mode button: it cycles through the modes. -->
    <string name="term_mode_switch_hint">点按切换权限模式（应用 / Root / ADB）</string>
    <!-- Hint of the command input field. -->
    <string name="term_hint">输入命令</string>
    <!-- Button: run the entered command. -->
    <string name="term_run">运行</string>
    <!-- Button: stop the running command. -->
    <string name="term_stop">停止</string>
    <!-- Button: clear the console output. -->
    <string name="term_clear">清空</string>
    <!-- Button: recall the previous command from the history. -->
    <string name="term_history_up">↑</string>
    <!-- Button: recall the next command from the history. -->
    <string name="term_history_down">↓</string>

    <!-- Section label above the remote tool quick action buttons. -->
    <string name="term_quick_actions">远程工具快捷操作</string>
    <!-- Quick action button: start the matching remote tool.
         Param 1: the translated name of the tool. -->
    <string name="term_tool_start_fmt">启动 %1$s</string>
    <!-- Quick action button: stop the matching remote tool.
         Param 1: the translated name of the tool. -->
    <string name="term_tool_stop_fmt">停止 %1$s</string>
    <!-- Toast after tapping a quick action that starts a tool.
         Param 1: the translated name of the tool. -->
    <string name="term_tool_starting_toast_fmt">正在启动 %1$s…</string>
    <!-- Toast after tapping a quick action that stops a tool.
         Param 1: the translated name of the tool. -->
    <string name="term_tool_stopping_toast_fmt">正在停止 %1$s…</string>

    <!-- Placeholder shown while the console has no output yet. -->
    <string name="term_console_empty">暂无输出，输入命令后点击“运行”。</string>
    <!-- Status text while a command is running. -->
    <string name="term_status_running">运行中…</string>
    <!-- Status text while no command is running. -->
    <string name="term_status_idle">就绪</string>

    <!-- Error: no "su" binary available for the root mode. -->
    <string name="term_no_su">未找到可用的 su，无法以 Root 权限运行命令。</string>
    <!-- Hint shown after "term_no_su"; how to fix the problem. -->
    <string name="term_no_su_hint">请在设置中检查 Root 模式和 su 路径。</string>
    <!-- Error: the ADB mode is selected but there is no ADB connection. -->
    <string name="term_need_adb">尚未连接 ADB 无线调试，请先在“远程与监控”中配对并连接。</string>
    <!-- Error when running a command failed.
         Param 1: the error message. -->
    <string name="term_io_error_fmt">执行失败：%1$s</string>

    <!-- Echo of the command that is being run.
         Param 1: the command line. -->
    <string name="term_started_fmt">$ %1$s</string>
    <!-- The process exited on its own.
         Param 1: the exit code. -->
    <string name="term_finished_fmt">[进程已退出，返回码 %1$d]</string>
    <!-- The process was stopped by the user. -->
    <string name="term_stopped_fmt">[进程已被停止]</string>

    <!-- Example commands the user can try. -->
    <string name="term_help">示例：id、getprop、frpc -c …、tailscale status、nezha-agent -c …</string>
    <!-- Note about long-running tasks and where to find them. -->
    <string name="term_bg_note">长时间运行的任务会在后台持续运行，请在“远程与监控”屏幕查看状态。</string>
</resources>
