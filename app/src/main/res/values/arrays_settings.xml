<?xml version="1.0" encoding="utf-8"?>
<!--suppress LongLine -->
<resources>

    <!-- 单选：SSH 登录/内置终端的提权模式显示名称。
         对应的取值数组见 st_ev_shell_mode。 -->
    <string-array name="st_et_shell_mode">
        <item>@string/pe_mode_app</item>
        <item>@string/pe_mode_root</item>
        <item>@string/pe_mode_adb</item>
    </string-array>

    <!-- 单选：SSH 登录/内置终端的提权模式存储值（app/root/adb）。 -->
    <string-array name="st_ev_shell_mode">
        <item>app</item>
        <item>root</item>
        <item>adb</item>
    </string-array>

    <!-- 单选：远程 ADB 桥接命令策略模式显示名称。 -->
    <string-array name="adb_bridge_policy_entries">
        <item>@string/pe_adb_bridge_policy_allowlist</item>
        <item>@string/pe_adb_bridge_policy_denylist</item>
        <item>@string/pe_adb_bridge_policy_open</item>
    </string-array>

    <!-- 单选：远程 ADB 桥接命令策略模式存储值（ALLOWLIST/DENYLIST/OPEN）。 -->
    <string-array name="adb_bridge_policy_values">
        <item>ALLOWLIST</item>
        <item>DENYLIST</item>
        <item>OPEN</item>
    </string-array>

</resources>
